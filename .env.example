# Module 1
POSTGRES_DB=finguard
POSTGRES_USER=finguard
POSTGRES_PASSWORD=change-me
# Local processes use these addresses. Keep PGPORT in sync with the host mapping.
PGHOST=127.0.0.1
PGPORT=55432
REDIS_URL=redis://127.0.0.1:56379/0
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# Optional Compose-only overrides. Defaults use the service network.
# COMPOSE_PGHOST=db
# COMPOSE_PGPORT=5432
# COMPOSE_REDIS_URL=redis://redis:6379/0
# COMPOSE_BACKEND_INTERNAL_URL=http://backend:8000
DART_API_KEY=
# Use the decoded key. Enable KRX listing, stock price and securities product APIs.
FSC_SERVICE_KEY=

# Module 2
IS_VIRTUAL=true
# Live app credentials are also used for market data in virtual account mode.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_VIRTUAL_APP_KEY=
KIS_VIRTUAL_APP_SECRET=
KIS_VIRTUAL_ACCOUNT_NO=
KIS_VIRTUAL_ACCOUNT_PRODUCT_CODE=01
# Required by PyKRX for KRX-authenticated data.
KRX_ID=
KRX_PW=

# Modules 3–8
ECOS_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
APP_ACCESS_PIN=
