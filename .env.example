# 이 파일을 .env로 복사한 뒤 발급받은 키를 .env에만 입력하세요.

# PostgreSQL 및 로컬 실행 주소
POSTGRES_DB=finguard
POSTGRES_USER=finguard
# 직접 정한 DB 비밀번호로 바꾸세요.
POSTGRES_PASSWORD=change-me
# PGPORT는 PostgreSQL의 호스트 공개 포트와 맞추세요.
PGHOST=127.0.0.1
PGPORT=55432
REDIS_URL=redis://127.0.0.1:56379/0
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# Docker Compose는 기본적으로 내부 서비스 주소를 사용합니다.
# 내부 주소를 변경할 때만 아래 변수의 주석을 해제하세요.
# COMPOSE_PGHOST=db
# COMPOSE_PGPORT=5432
# COMPOSE_REDIS_URL=redis://redis:6379/0
# COMPOSE_BACKEND_INTERNAL_URL=http://backend:8000

# OpenDART 공시 및 금융위원회 데이터
DART_API_KEY=
# 공공데이터포털의 일반 인증키(Decoding)를 입력하세요.
# KRX상장종목정보, 주식시세정보, 증권상품시세정보, 주식발행정보는 각각 활용신청이 필요합니다.
FSC_SERVICE_KEY=

# 증권사 계좌 설정 (toss 또는 kis)
BROKER_PROVIDER=toss
# 토스증권 웹 설정의 Open API 메뉴에서 발급받은 인증 정보
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 종합매매 계좌가 하나면 생략. 여러 개면 계좌 목록 API의 accountSeq를 입력.
TOSS_ACCOUNT_SEQ=

# 한국투자증권 계좌 설정 (BROKER_PROVIDER=kis)
# IS_VIRTUAL은 한국투자증권의 모의(true)·실전(false) 전환에만 쓰입니다.
IS_VIRTUAL=false
# 모의 계좌를 사용해도 시세 조회에는 실전 앱 키와 시크릿이 필요합니다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01
# 시연·테스트로 모의 계좌를 사용할 때만 입력합니다.
KIS_VIRTUAL_APP_KEY=
KIS_VIRTUAL_APP_SECRET=
KIS_VIRTUAL_ACCOUNT_NO=
KIS_VIRTUAL_ACCOUNT_PRODUCT_CODE=01

# PyKRX로 KRX 인증 데이터를 조회할 때 사용하는 로그인 정보
KRX_ID=
KRX_PW=

# 한국은행 ECOS 환율·금리 및 네이버 뉴스
ECOS_API_KEY=
# NAVER API HUB에서 발급받은 키는 NAVER_API_HUB=true와 함께 사용합니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_API_HUB=false

# Alibaba Cloud Model Studio (DashScope) · 라우터 및 종목 워커
# DashScope 콘솔에서 발급한 API 키를 입력하세요.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ROUTER_MODEL=qwen3.7-plus
WORKER_MODEL=qwen3.8-flash

# Google AI Studio · 종합 진단, DashScope 한도 초과 시 대체 모델, RAGAS 채점
GEMINI_API_KEY=
SYNTHESIZER_MODEL=gemini-3.8-flash

# 대시보드 접속 시 입력할 PIN을 직접 정하세요.
APP_ACCESS_PIN=
